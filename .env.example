OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.2
TYPESAFE_API_KEY=
WIKI_DIR=wiki
SOURCE_DIR=sources
# Direct Uvicorn runs use output/chat-access.sqlite3 by default. Compose sets
# this to the existing durable runtime volume. Run one Uvicorn worker.
# CLIMATE_CHAT_ACCESS_DB=/absolute/durable/chat-access.sqlite3
RELOAD_TOKEN=
# Public hostname (no scheme) for the Caddy public site block. Keep in sync
# with CLIMATE_PUBLIC_ORIGIN (the full https:// origin used by the app).
PUBLIC_HOST=
# Required internal host/IP for Caddy TLS and host health checks (no scheme).
SITE_HOST=
# Three-octet prefix of the dedicated Compose app/Caddy network. Change this
# together through this one setting if the default bridge subnet conflicts.
CLIMATE_PROXY_NETWORK_PREFIX=172.30.211
# Full https:// origin the app uses for building callback URLs (Hermes
# dashboard OAuth, etc). Keep in sync with PUBLIC_HOST above.
CLIMATE_PUBLIC_ORIGIN=
# Optional for a directly launched app:
# CLIMATE_DELIVERY_OUTPUT_DIR=/absolute/read-only/delivery-output
# Optional host path for docker-compose.delivery.yml:
# CLIMATE_DELIVERY_ARTIFACTS_HOST_DIR=/absolute/read-only/delivery-output

# One external business Registry, shared by Wiki acquisition and PDF intake.
# Create this host directory and migrate the DB before Compose; no auto-creation.
CLIMATE_REGISTRY_HOST_DIR=
# Container namespace. Change the filename here once for both existing writers.
# Registry overrides default to /registry/article-registry.sqlite3. Set this once
# to change the filename for both writers. Static-only base deployments leave it empty.
CLIMATE_REGISTRY_DB=
# Host CLI rehearsals use an explicit --database under CLIMATE_REGISTRY_HOST_DIR.
