# Climate Monitor Wiki — public HTTPS plus private-IP TLS.
#
# The public hostname uses Caddy's automatic public-CA certificate management.
# The private host IP remains available with a Caddy internal-CA certificate
# for host-local health checks (see docs/deployment.md).
#
# default_sni is REQUIRED here: clients connecting to a bare IP literal send no
# SNI (RFC 6066 forbids IP addresses in SNI), so without it Caddy cannot match
# a site block and aborts the handshake with "tlsv1 alert internal error".
{
	auto_https disable_redirects
	default_sni {$SITE_HOST:172.31.10.77}

	# Runtime/error logs go to container stdout/stderr and are retained by the
	# Docker logging driver. Preserve request paths for outage diagnosis, but
	# remove every query string before encoding so callback credentials cannot
	# escape through reverse-proxy errors when the application is unavailable.
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
			}
		}
	}
}

# Shared site body: same reverse proxy + file logger for every hostname.
# Imported by the public and internal site blocks so application logic lives
# in exactly one place.
(climate-wiki-site) {
	encode gzip zstd

	# Security headers are set by the application (api_server.py). Re-declaring
	# them here without a modifier emitted every header twice, because the
	# directive ran before `reverse_proxy` copied the upstream headers in.
	# `>` is Caddy's DEFER modifier: it postpones the header operation until
	# after the proxy has copied upstream headers, so the deferred Set
	# replaces the upstream value instead of coexisting with it. Do NOT drop
	# the `>` — without it the duplicate headers come back.
	header > Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	header > X-Content-Type-Options "nosniff"
	header > X-Frame-Options "DENY"
	header > Referrer-Policy "strict-origin-when-cross-origin"
	header > Permissions-Policy "geolocation=(), microphone=(), camera=()"

	# Edge enforcement of the body cap. The application also checks a declared
	# Content-Length, but that cannot see chunked bodies; Caddy can.
	request_body {
		max_size 200KB
	}

	# OAuth providers return short-lived credentials in this callback's query.
	# Suppress the complete callback request rather than persisting code/state in
	# the JSON URI field. Application-side state validation remains unchanged.
	@hermes_oauth_callback path /hermes/api/mcp/oauth/callback/*
	log_skip @hermes_oauth_callback

	reverse_proxy wiki:8501 {
		health_uri /api/config
		health_interval 30s
		health_timeout 5s
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# Public site — served over automatic (public-CA) HTTPS at the real hostname.
https://climate.aiinforsearch.com {
	import climate-wiki-site
}

# Internal site — private VPC IP, used by the host's own health-check loop.
# Kept on Caddy's internal CA; do not point external users here.
https://{$SITE_HOST:172.31.10.77} {
	tls internal
	import climate-wiki-site
}

# Plain HTTP redirects to HTTPS so http://<host> still lands on the app.
http://climate.aiinforsearch.com {
	redir https://{host}{uri} permanent
}

http://{$SITE_HOST:172.31.10.77} {
	redir https://{host}{uri} permanent
}
