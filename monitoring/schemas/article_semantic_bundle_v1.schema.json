{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferryhe/climate_monitor_wiki/monitoring/schemas/article_semantic_bundle_v1.schema.json",
  "title": "Article semantic bundle v1",
  "description": "One atomic Hermes-authored summary/categories/keywords bundle. Category membership and item-count bounds are validated against monitoring/taxonomies/article_categories_v1.yaml, the authoritative taxonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_id",
    "taxonomy_sha256",
    "summary",
    "categories",
    "keywords"
  ],
  "properties": {
    "schema_version": {
      "const": "article-semantic-bundle.v1"
    },
    "taxonomy_id": {
      "const": "climate-actuarial-v1"
    },
    "taxonomy_sha256": {
      "const": "3deefa1cc0df7a2e1ce8ef538271c0ab4465bb928f20e6418aafc8a834794d94"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\r\\n\\t]+$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[^\\r\\n\\t]+$"
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[^,;\\r\\n\\t]+$"
      }
    }
  }
}
