{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferryhe/climate_monitor_wiki/monitoring/schemas/url_first_article_candidate_batch_v1.schema.json",
  "title": "URL-first article candidate batch v1",
  "description": "Strict batch envelope. Python validation additionally recomputes nested identities and digests, candidate_count, uniqueness, and canonical URL order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_count", "candidates", "batch_digest"],
  "properties": {
    "schema_version": {
      "const": "url-first-article-candidate-batch.v1"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://github.com/ferryhe/climate_monitor_wiki/monitoring/schemas/url_first_article_candidate_v1.schema.json"
      }
    },
    "batch_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
