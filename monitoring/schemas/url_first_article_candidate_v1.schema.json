{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferryhe/climate_monitor_wiki/monitoring/schemas/url_first_article_candidate_v1.schema.json",
  "title": "URL-first article candidate v1",
  "description": "Strict structural schema for one URL identity and its discovery origins. Python validation additionally recomputes canonical_url, article_id, display_pillar, canonical array order, origin uniqueness, and candidate_digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "url",
    "canonical_url",
    "article_id",
    "display_pillar",
    "origins",
    "title",
    "title_basis",
    "summary",
    "summary_basis",
    "categories",
    "categories_basis",
    "candidate_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "url-first-article-candidate.v1"
    },
    "url": {
      "$ref": "#/$defs/httpUrl"
    },
    "canonical_url": {
      "$ref": "#/$defs/httpUrl"
    },
    "article_id": {
      "$ref": "#/$defs/sha256"
    },
    "display_pillar": {
      "enum": ["A", "B"]
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/origin"
      }
    },
    "title": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/title"}
      ]
    },
    "title_basis": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["page", "search_result", "upstream_artifact", "url"]}
      ]
    },
    "summary": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/longText"}
      ]
    },
    "summary_basis": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["page", "search_result", "change_event", "upstream_artifact"]}
      ]
    },
    "categories": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        }
      ]
    },
    "categories_basis": {
      "oneOf": [
        {"type": "null"},
        {"const": "upstream_classification"}
      ]
    },
    "candidate_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"title": {"type": "null"}}},
      "then": {"properties": {"title_basis": {"type": "null"}}},
      "else": {"properties": {"title_basis": {"type": "string"}}}
    },
    {
      "if": {"properties": {"summary": {"type": "null"}}},
      "then": {"properties": {"summary_basis": {"type": "null"}}},
      "else": {"properties": {"summary_basis": {"type": "string"}}}
    },
    {
      "if": {"properties": {"categories": {"type": "null"}}},
      "then": {"properties": {"categories_basis": {"type": "null"}}},
      "else": {"properties": {"categories_basis": {"type": "string"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*)(?::[0-9]+)?(?:[/?#][^\\s]*)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pillar",
        "source",
        "url",
        "input_artifact",
        "row",
        "discovered_at",
        "original_title",
        "title_basis",
        "original_summary",
        "summary_basis",
        "original_snippet",
        "snippet_basis"
      ],
      "properties": {
        "pillar": {"enum": ["A", "B"]},
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "url": {"$ref": "#/$defs/httpUrl"},
        "input_artifact": {"$ref": "#/$defs/artifactIdentity"},
        "row": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
        },
        "discovered_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "original_title": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/title"}
          ]
        },
        "title_basis": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["page", "search_result", "upstream_artifact", "url"]}
          ]
        },
        "original_summary": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/longText"}
          ]
        },
        "summary_basis": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["page", "search_result", "change_event", "upstream_artifact"]}
          ]
        },
        "original_snippet": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/longText"}
          ]
        },
        "snippet_basis": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["page", "search_result", "change_event", "upstream_artifact"]}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"original_title": {"type": "null"}}},
          "then": {"properties": {"title_basis": {"type": "null"}}},
          "else": {"properties": {"title_basis": {"type": "string"}}}
        },
        {
          "if": {"properties": {"original_summary": {"type": "null"}}},
          "then": {"properties": {"summary_basis": {"type": "null"}}},
          "else": {"properties": {"summary_basis": {"type": "string"}}}
        },
        {
          "if": {"properties": {"original_snippet": {"type": "null"}}},
          "then": {"properties": {"snippet_basis": {"type": "null"}}},
          "else": {"properties": {"snippet_basis": {"type": "string"}}}
        }
      ]
    }
  }
}
